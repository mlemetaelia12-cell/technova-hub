# Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Generate independent random secrets; never commit real values
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
RECOVERY_PEPPER="replace-with-another-independent-random-secret"

# Existing private administrator credentials (server only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-unique-strong-password"
ADMIN_PASSWORD_HASH=""

# Groq AI (server only)
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"
CRON_SECRET="replace-with-a-long-random-cron-secret"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
